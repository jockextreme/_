<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sulasok - Premium Video Gallery</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body { font-family: 'Poppins', sans-serif; }
    .card { transition: all 0.4s ease; }
    .card:hover { transform: translateY(-10px); box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15); }
    .play-icon { transition: all 0.3s ease; }
    .card:hover .play-icon { transform: scale(1.2); opacity: 0; }
    .video-preview { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.5s ease; }
    .card:hover .video-preview { opacity: 1; }
    .thumbnail-img { transition: opacity 0.5s ease; }
    .card:hover .thumbnail-img { opacity: 0; }
    .skeleton { background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%); background-size: 200% 100%; animation: loading 1.8s infinite; }
    .dark .skeleton { background: linear-gradient(90deg, #374151 25%, #4b5563 50%, #374151 75%); }
    @keyframes loading { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
    .heart { transition: all 0.3s ease; }
    .heart.active { color: #ef4444; transform: scale(1.2); }
  </style>
</head>
<body class="bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 min-h-screen transition-colors duration-500">
  <!-- Navigation -->
  <header class="sticky top-0 z-40 bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 shadow-sm">
    <div class="container mx-auto px-6 py-4 flex items-center justify-between">
      <h1 class="text-3xl font-bold text-indigo-600 dark:text-indigo-400">Sulasok</h1>
      <div class="flex items-center gap-6">
        <button id="favorites-btn" class="flex items-center gap-2 px-4 py-2 rounded-lg bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 transition">
          <i class="fas fa-heart text-red-500"></i>
          <span>Favorites (<span id="fav-count">0</span>)</span>
        </button>
        <p id="video-count" class="text-lg text-gray-600 dark:text-gray-400">Loading...</p>
        <button id="theme-toggle" class="p-3 rounded-lg bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 transition">
          <i class="fas fa-moon text-xl"></i>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Grid -->
  <main class="container mx-auto px-6 py-12 max-w-7xl">
    <div id="video-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-8">
      <!-- Videos load here -->
    </div>

    <div id="loading" class="text-center py-16 hidden">
      <i class="fas fa-circle-notch fa-spin text-4xl text-indigo-500 mb-4"></i>
      <p class="text-xl text-gray-600 dark:text-gray-400">Loading more videos...</p>
    </div>

    <div id="end" class="text-center py-20 hidden">
      <p class="text-2xl font-medium text-gray-500 dark:text-gray-400">No more videos available</p>
    </div>

    <div id="error" class="text-center py-20 hidden">
      <p class="text-2xl font-medium text-red-500">Failed to load videos.<br>
        <span class="text-lg block mt-4">Host on Netlify/Vercel to fix this</span>
      </p>
    </div>
  </main>

  <!-- Modal Player -->
  <div id="modal" class="fixed inset-0 bg-black/90 hidden flex items-center justify-center z-50 backdrop-blur-md">
    <div class="relative w-full max-w-5xl mx-6">
      <button id="close-modal" class="absolute -top-14 right-0 text-white text-4xl hover:text-indigo-400 transition">
        <i class="fas fa-times"></i>
      </button>
      <div class="aspect-video bg-black rounded-xl overflow-hidden shadow-2xl mb-6">
        <iframe id="video-frame" class="w-full h-full" frameborder="0" allowfullscreen allow="autoplay"></iframe>
      </div>
      <div class="flex justify-center gap-4 flex-wrap">
        <button class="share-btn px-5 py-3 bg-blue-600 hover:bg-blue-700 rounded-lg text-white flex items-center gap-2" data-type="copy">
          <i class="fas fa-link"></i> Copy Link
        </button>
        <button class="share-btn px-5 py-3 bg-green-600 hover:bg-green-700 rounded-lg text-white flex items-center gap-2" data-type="whatsapp">
          <i class="fab fa-whatsapp"></i> WhatsApp
        </button>
        <button class="share-btn px-5 py-3 bg-black hover:bg-gray-800 rounded-lg text-white flex items-center gap-2" data-type="twitter">
          <i class="fab fa-x-twitter"></i> Share on X
        </button>
        <button class="share-btn px-5 py-3 bg-blue-800 hover:bg-blue-900 rounded-lg text-white flex items-center gap-2" data-type="facebook">
          <i class="fab fa-facebook"></i> Facebook
        </button>
      </div>
    </div>
  </div>

  <script>
    const grid = document.getElementById('video-grid');
    const loading = document.getElementById('loading');
    const end = document.getElementById('end');
    const error = document.getElementById('error');
    const videoCount = document.getElementById('video-count');
    const favCount = document.getElementById('fav-count');
    const favoritesBtn = document.getElementById('favorites-btn');
    const modal = document.getElementById('modal');
    const videoFrame = document.getElementById('video-frame');
    const closeModal = document.getElementById('close-modal');
    const themeToggle = document.getElementById('theme-toggle');

    let page = 1;
    let totalVideos = 0;
    let allVideos = []; // Store all loaded videos
    let favorites = JSON.parse(localStorage.getItem('sulasok_favorites') || '[]');
    let showingFavorites = false;
    let loadingData = false;
    let hasMore = true;

    // Update favorite count
    function updateFavCount() {
      favCount.textContent = favorites.length;
    }
    updateFavCount();

    // Theme toggle
    if (localStorage.theme === 'light') document.documentElement.classList.remove('dark');
    themeToggle.addEventListener('click', () => {
      document.documentElement.classList.toggle('dark');
      localStorage.theme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
      themeToggle.querySelector('i').classList.toggle('fa-moon');
      themeToggle.querySelector('i').classList.toggle('fa-sun');
    });

    // Toggle favorites view
    favoritesBtn.addEventListener('click', () => {
      showingFavorites = !showingFavorites;
      favoritesBtn.classList.toggle('bg-indigo-600', showingFavorites);
      favoritesBtn.classList.toggle('text-white', showingFavorites);
      grid.innerHTML = '';
      if (showingFavorites) {
        renderVideos(allVideos.filter(v => favorites.includes(v.iframeUrl)));
        videoCount.textContent = `Favorites (${favorites.length})`;
      } else {
        renderVideos(allVideos);
        videoCount.textContent = `Showing ${totalVideos} videos`;
      }
    });

    // Mock duration (replace with real when API has it)
    function mockDuration() {
      const mins = Math.floor(Math.random() * 15) + 1;
      const secs = Math.floor(Math.random() * 60).toString().padStart(2, '0');
      return `${mins}:${secs}`;
    }

    // Extract video src for preview
    function extractVideoSrc(iframeUrl) {
      try {
        const url = new URL(iframeUrl);
        if (url.hostname.includes('youtube.com') || url.hostname.includes('youtu.be')) {
          const v = url.searchParams.get('v') || iframeUrl.split('/').pop();
          return `https://www.youtube.com/embed/${v}?autoplay=1&mute=1&controls=0&loop=1&playlist=${v}&modestbranding=1`;
        }
        return null;
      } catch {
        return null;
      }
    }

    // Create skeleton card
    function createSkeleton() {
      const card = document.createElement('div');
      card.className = 'bg-white dark:bg-gray-800 rounded-xl overflow-hidden shadow-md border border-gray-200 dark:border-gray-700';
      card.innerHTML = `
        <div class="aspect-video skeleton"></div>
        <div class="p-5 space-y-3">
          <div class="h-6 skeleton rounded w-3/4"></div>
          <div class="h-4 skeleton rounded w-full"></div>
          <div class="h-4 skeleton rounded w-5/6"></div>
        </div>
      `;
      return card;
    }

    // Render videos (used for both normal and favorites)
    function renderVideos(videos) {
      grid.innerHTML = '';
      videos.forEach(item => {
        const videoSrc = extractVideoSrc(item.iframeUrl);
        const isFav = favorites.includes(item.iframeUrl);

        const card = document.createElement('div');
        card.className = 'card bg-white dark:bg-gray-800 rounded-xl overflow-hidden shadow-md cursor-pointer border border-gray-200 dark:border-gray-700 relative';

        card.innerHTML = `
          <div class="aspect-video relative overflow-hidden bg-gray-100 dark:bg-gray-900">
            <img src="${item.thumbnail}" alt="${item.title}" loading="lazy" class="thumbnail-img w-full h-full object-cover absolute inset-0">
            ${videoSrc ? `<iframe src="${videoSrc}" class="video-preview pointer-events-none" frameborder="0" allow="autoplay"></iframe>` : ''}
            <div class="absolute inset-0 flex items-center justify-center bg-black/20">
              <i class="fas fa-play-circle play-icon text-6xl text-white drop-shadow-lg"></i>
            </div>
            <div class="absolute bottom-2 right-2 bg-black/70 text-white px-2 py-1 rounded text-sm font-medium">
              ${mockDuration()}
            </div>
          </div>
          <div class="p-5 flex justify-between items-start">
            <h3 class="font-semibold text-lg leading-tight line-clamp-3 flex-1">${item.title}</h3>
            <button class="heart ml-4 text-2xl ${isFav ? 'active text-red-500' : 'text-gray-400 hover:text-red-500'}">
              <i class="fas fa-heart"></i>
            </button>
          </div>
        `;

        // Click to play
        card.querySelector('.aspect-video').onclick = () => {
          videoFrame.src = item.iframeUrl;
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          // Update share buttons
          document.querySelectorAll('.share-btn').forEach(btn => {
            btn.onclick = () => shareVideo(item.iframeUrl, item.title, btn.dataset.type);
          });
        };

        // Favorite toggle
        card.querySelector('.heart').onclick = (e) => {
          e.stopPropagation();
          const index = favorites.indexOf(item.iframeUrl);
          if (index > -1) {
            favorites.splice(index, 1);
          } else {
            favorites.push(item.iframeUrl);
          }
          localStorage.setItem('sulasok_favorites', JSON.stringify(favorites));
          updateFavCount();
          card.querySelector('.heart').classList.toggle('active');
          card.querySelector('.heart').classList.toggle('text-red-500');
        };

        grid.appendChild(card);
      });
    }

    // Share functionality
    function shareVideo(url, title, platform) {
      const shareUrl = encodeURIComponent(url);
      const text = encodeURIComponent(`Watch: ${title}`);
      let link = '';
      switch(platform) {
        case 'copy':
          navigator.clipboard.writeText(url);
          alert('Link copied!');
          return;
        case 'whatsapp':
          link = `https://wa.me/?text=${text}%20${shareUrl}`;
          break;
        case 'twitter':
          link = `https://twitter.com/intent/tweet?text=${text}&url=${shareUrl}`;
          break;
        case 'facebook':
          link = `https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`;
          break;
      }
      window.open(link, '_blank');
    }

    async function loadVideos() {
      if (loadingData || !hasMore || showingFavorites) return;
      loadingData = true;
      loading.classList.remove('hidden');

      // Add skeletons
      for (let i = 0; i < 10; i++) grid.appendChild(createSkeleton());

      try {
        const response = await fetch(`https://betadash-api-swordslush-production.up.railway.app/sulasok?page=${page}`);
        if (!response.ok) throw new Error('Network error');
        const data = await response.json();

        // Remove skeletons
        grid.querySelectorAll('.skeleton').forEach(el => el.parentElement.remove());

        if (data.results && data.results.length > 0) {
          allVideos = allVideos.concat(data.results);
          renderVideos(allVideos);
          totalVideos += data.results.length;
          videoCount.textContent = `Showing ${totalVideos} videos`;
          page++;
        } else {
          hasMore = false;
          end.classList.remove('hidden');
        }
      } catch (err) {
        console.error(err);
        error.classList.remove('hidden');
        hasMore = false;
      }

      loading.classList.add('hidden');
      loadingData = false;
    }

    // Infinite scroll
    window.addEventListener('scroll', () => {
      if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 1000) {
        loadVideos();
      }
    });

    // Modal close
    closeModal.onclick = modal.onclick = (e) => {
      if (e.target === modal || e.target === closeModal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        videoFrame.src = '';
      }
    };

    // Initial load
    loadVideos();
  </script>
</body>
</html>
